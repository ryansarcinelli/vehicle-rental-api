# Copie para .env antes de rodar `docker compose up`.
# O arquivo .env não é versionado.

# --- Banco ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vehiclerental
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# --- JWT ---
# Obrigatório, mínimo 32 caracteres. Em produção use um valor aleatório e secreto.
JWT_SECRET=troque-esta-chave-por-um-valor-aleatorio-de-32-caracteres
JWT_EXPIRATION_MINUTES=60

# --- Seed ---
# Senha do usuário admin@vehiclerental.com criado no primeiro startup.
SEED_ADMIN_PASSWORD=Admin@123456
